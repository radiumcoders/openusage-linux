// Merge this key into the Waybar config, and add "custom/openusage" to a modules-* list.
// Left click refreshes every account now. Right click lists the accounts in a floating terminal
// (titled "openusage"; see contrib/hyprland) through xdg-terminal-exec.
{
  "custom/openusage": {
    "exec": "openusage waybar",
    "return-type": "json",
    "on-click": "openusage waybar --refresh",
    "on-click-right": "xdg-terminal-exec --title=openusage sh -c 'openusage accounts; printf \"\\nPress Enter to close.\"; read -r _'"
  }
}
