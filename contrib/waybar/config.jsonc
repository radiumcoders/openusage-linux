// Merge this key into the Waybar config, and add "custom/openusage" to a modules-* list.
// Left click opens the panel. Right click refreshes every account now.
{
  "custom/openusage": {
    "exec": "openusage waybar",
    "return-type": "json",
    "on-click": "openusage-panel --toggle",
    "on-click-right": "openusage waybar --refresh"
  }
}
